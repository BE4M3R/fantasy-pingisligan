# Copy to your own ignored .env.local. Local Supabase values only.
# Start the stack with npm run db:start; obtain keys with npx supabase status.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-local-anon-or-publishable-key
SUPABASE_URL=http://127.0.0.1:54321
# Local service-role key for catalogue setup and synthetic scenarios only.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-local-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
