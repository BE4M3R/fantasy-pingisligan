{
  "name": "fantasy-pingisligan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:players": "node scripts/import-profixio-players.mjs",
    "import:players:dry": "node scripts/import-profixio-players.mjs --dry-run",
    "import:schedule": "node scripts/import-stupa-schedule.mjs",
    "import:schedule:dry": "node scripts/import-stupa-schedule.mjs --dry-run",
    "import:results": "node scripts/import-stupa-results.mjs",
    "import:results:dry": "node scripts/import-stupa-results.mjs --dry-run",
    "seed:accounts": "node scripts/seed-staging-accounts.mjs",
    "seed:local-accounts": "node scripts/seed-staging-accounts.mjs --env local",
    "seed:staging-accounts": "node scripts/seed-staging-accounts.mjs --env staging",
    "test:performance": "node --test scripts/performance.test.mjs",
    "test:imports": "node --test scripts/player-identity.test.mjs",
    "test:gameweek": "node scripts/staging-gameweek-test.mjs",
    "test:local": "node scripts/staging-gameweek-test.mjs --env local",
    "test:staging": "node scripts/staging-gameweek-test.mjs --env staging",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "dbsetup:local": "npm run db:start && npx supabase db reset --local && npm run import:players && npm run seed:local-accounts -- seed --count 10 && npm run test:local -- setup",
    "db:lint": "supabase db lint --local --level error --fail-on error",
    "db:new": "supabase migration new",
    "db:status": "supabase migration list"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
